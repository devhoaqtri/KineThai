# KineMedia / kinetic-canvas — root app environment
# Full auto-posting guide: docs/lovable-auto-posting-credentials.md

# ── Supabase (Lovable Cloud → Connect Supabase) ─────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Browser mirrors (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose as VITE_*
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: HTTP ingest from content-hub (SINK=http) ───────────────────────
# AGENT_INGEST_API_KEY=

# ── Admin demo ───────────────────────────────────────────────────────────────
# Put this in .env.local (git-ignored), never in the committed .env. It only works
# under npm run dev: a production build ignores it.
VITE_DEMO_ADMIN=1
# ADMIN_USER_IDS=uuid1,uuid2

# ── Facebook + Instagram Reels (scripts/lib/meta-publish.ts, docs/meta-publishing.md) ──
# Local only: put these in .env.local (git-ignored). `npm run tiktok -- meta-setup` fills the
# last three from META_USER_TOKEN and removes it.
# META_APP_ID=
# META_APP_SECRET=
# META_USER_TOKEN=
# META_PAGE_ID=
# META_PAGE_TOKEN=
# META_IG_USER_ID=
# META_GRAPH_VERSION=v23.0
# META_DRY_RUN=1
